{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8317",
    "ANTHROPIC_AUTH_TOKEN": "sk-dummy",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gpt-5.6-sol-fast(xhigh)",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-5.6-sol-fast(high)",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-5.6-sol-fast(medium)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-5.3-codex-spark(high)",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "272000",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_STATUS_LINE": "${provider} · ${model} · ${context-used} · ${codex-five-hour-limit} · ${codex-weekly-limit} · ${codex-five-hour-reset} · ${codex-weekly-reset}"
  },
  "permissions": {
    "allow": [ ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 ~/.claude/hooks/rtk_pre_tool_use.py",
            "timeout": 10,
            "statusMessage": "Applying RTK command wrapper..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": { },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled"
}
